# Copy to .env. Do not commit .env or put real secrets here.
# Never prefix these with VITE_: that would publish them in the browser bundle.

# Admin password for the private /billing workspace. At least 8 characters.
BILLING_ADMIN_PASSWORD=

# Local development: SQLite file. Defaults to data/billing.sqlite.
BILLING_DATABASE_PATH=data/billing.sqlite

# Vercel / production: hosted libSQL (Turso) database. Required on Vercel.
# BILLING_DATABASE_URL=libsql://your-db.turso.io
# BILLING_DATABASE_AUTH_TOKEN=

# API port used by `npm start` and the dev API process.
PORT=8787
